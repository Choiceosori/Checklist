{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "checklist",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Gemini API는 일부 지역(예: 홍콩)에서 오는 호출을 막습니다("User location is not supported").
  // Google 호출은 미국 동부에 고정한 Durable Object(GeminiProxy)를 거쳐 보냅니다(src/worker.js).
  // 무료 플랜에서도 쓸 수 있도록 SQLite 기반으로 만듭니다.
  "durable_objects": { "bindings": [{ "name": "GEMINI_PROXY", "class_name": "GeminiProxy" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GeminiProxy"] }],
  // 위치 힌트(보조): /api 를 처리하는 Worker도 미국 중부 근처에서 실행되도록 요청합니다.
  "placement": { "mode": "targeted", "region": "gcp:us-central1" },
  "observability": { "enabled": true }
  // GEMINI_API_KEY, ACCESS_CODE 는 여기에 쓰지 마세요. Cloudflare 대시보드 > Settings > Variables and Secrets 에서 Secret으로 넣습니다.
}
