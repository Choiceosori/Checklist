{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lesson-plan-ai",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // GEMINI_API_KEY, ACCESS_CODE 는 여기에 쓰지 마세요. Cloudflare 대시보드 > Settings > Variables and Secrets 에서 Secret으로 넣습니다.
}
